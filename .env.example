# Copy this to .env and fill in real values. .env is gitignored.

# WiFi the router lives on (2.4 GHz). SSID is shown on the controller's screen.
WIFI_SSID=your-network
WIFI_PASSWORD=your-wifi-password

# OpenWRT router, reached over SSH by the laptop manager.
SSH_HOST=192.168.1.1
SSH_USER=root
SSH_PASSWORD=your-router-password

# Where the manager reads spells from: the NodeMCU's USB serial port.
SPELL_SERIAL_PORT=COM9
SPELL_SERIAL_BAUD=115200

# iperf3 target for the PUSH spell. Point this at a host running `iperf3 -s`.
IPERF_SERVER=192.168.1.100

# Safety: true = print what would run without touching the router.
# Set to false only when you actually want interfaces brought up/down.
DRY_RUN=true
